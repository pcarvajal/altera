{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testMatch": ["<rootDir>/test/**/*.test.ts"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/test/tsconfig.json" }]
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^shared$": "<rootDir>/../../packages/shared/dist/index.js"
  }
}
