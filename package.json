{
  "name": "workspace",
  "version": "0.0.1",
  "description": "A monorepo for shared code and services",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --filter !shared exec pnpm dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "start": "pnpm -r --filter !shared start",
    "format": "pnpm -r format",
    "clean": "pnpm -r run clean"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.3",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
